# Production build config. There is no Vite dev proxy in a deployed app, so the
# frontend must call the backends by absolute URL (both now send CORS headers).
# Vite loads .env.production only for `vite build`, so dev keeps using the proxy.
VITE_API_BASE_URL=https://poc-mc10-org-ai-marathoninvoiceautomation-srv.cfapps.us10-001.hana.ondemand.com/odata/v4/invoice-automation
VITE_PDF_SERVICE_BASE_URL=https://poc-mc10-org-ai-marathoninvoiceautomation-pysrv.cfapps.us10-001.hana.ondemand.com
